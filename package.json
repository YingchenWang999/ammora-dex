{
  "name": "ammora-dex",
  "version": "0.1.0",
  "private": true,
  "description": "A testnet-first constant-product AMM for Base Sepolia.",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @ammora/web dev",
    "build": "pnpm --filter @ammora/web build",
    "lint": "pnpm --filter @ammora/web lint",
    "test": "pnpm contract:test && pnpm --filter @ammora/web test",
    "check": "pnpm contract:check && pnpm --filter @ammora/web check",
    "contract:build": "forge build --root contracts",
    "contract:test": "forge test --root contracts -vvv",
    "contract:check": "forge fmt --root contracts --check && forge build --root contracts && forge test --root contracts -vvv",
    "contract:fmt": "forge fmt --root contracts",
    "contract:slither": "contracts/scripts/run-slither.sh",
    "contract:deploy:base-sepolia": "forge script --root contracts contracts/script/Deploy.s.sol:Deploy --rpc-url base_sepolia --broadcast --slow --verify -vvvv"
  }
}
